generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  @@map("users")
}

model Certificate {
  id                 String   @id @default(uuid())
  studentName        String
  courseName         String
  cpf                String
  workload           Int
  completionDate     DateTime
  page               String
  message            String?
  registrationNumber String   @unique
  ptsBook            String
  createdAt          DateTime @default(now())

  @@map("certificates")
}

/// Stores the ever-increasing sequence counter for registration numbers.
/// Page is derived from lastRegistrationIndex (ceil(n/50)).
/// PTSBook is always fixed as 001/currentYear.
/// Never decremented when certificates are deleted.
model CertificateSequence {
  id                    String @id @default("singleton")
  lastRegistrationIndex Int    @default(0)
  year                  Int

  @@map("certificate_sequences")
}
