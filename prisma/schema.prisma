generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  @@map("users")
}

model Certificate {
  id                 String          @id @default(uuid())
  studentName        String
  courseName         String
  cpf                String
  workload           Int
  completionDate     DateTime
  page               String
  registrationNumber String
  ptsBook            String
  createdAt          DateTime        @default(now())
  type               CertificateType

  @@map("certificates")
}

enum CertificateType {
  BRIGADISTA
  CIPEIRO
  DIRECAO_DEFENSIVA
  NR06_EPI
  BENZENO_NR20
  DIRECAO_4X4
}

model CertificateSequence {
  typeId                String          @default(uuid())
  year                  Int
  lastRegistrationIndex Int             @default(0)
  type                  CertificateType

  @@id([type, year])
  @@map("certificate_sequences")
}
