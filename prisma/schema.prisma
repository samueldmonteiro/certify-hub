generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  @@map("users")
}

model Certificate {
  id                 String   @id @default(uuid())
  studentName        String
  courseName         String
  cpf                String
  workload           Int
  completionDate     DateTime
  page               String
  registrationNumber String   @unique
  ptsBook            String
  fileURL            String?
  createdAt          DateTime @default(now())

  @@map("certificates")
}
